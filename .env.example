# Client ────────────────────────────────────────────────
# "mock" switches the app to generated sample data.
VITE_FEED=
# Use a different endpoint speaking the /api/events protocol.
VITE_FEED_URL=
VITE_FEED_POLL_MS=60000

# Server (dev server and `npm start`) ──────────────────
GDELT_BACKLOG_HOURS=24
GDELT_CACHE_FILE=.cache/gdelt-events.json
PORT=8080

# Sources: gdelt, telegram (comma-separated)
FEED_SOURCES=gdelt,telegram
# Public Telegram channels read via t.me/s/<channel>, as username@Home area.
# The home area (a city, or "Ukraine") is where posts that name no specific
# place are shown; leave it off to show only posts that name a place.
# Links and @names work too: https://t.me/info_zp/173092@Zaporizhzhia
TELEGRAM_CHANNELS=lumsrc@Ukraine,GeneralStaffZSU@Ukraine,nakipelovo@Kharkiv,info_zp@Zaporizhzhia
TELEGRAM_POLL_MS=120000
TELEGRAM_CACHE_FILE=.cache/telegram-posts.json
GEONAMES_DIR=.cache/geonames

# Translation of Ukrainian/Russian posts to English:
#   auto   = Claude when ANTHROPIC_API_KEY is set, otherwise the local model
#   claude = Claude (best quality; needs ANTHROPIC_API_KEY)
#   local  = free offline opus-mt model (~150 MB one-time download)
#   off    = keep original language
TRANSLATE_ENGINE=auto
# ANTHROPIC_API_KEY=

# X (Twitter) accounts via the official X API (pay-per-use; needs a bearer token)
X_ACCOUNTS=
X_BEARER_TOKEN=
X_POLL_MS=300000

# News websites (RSS / JSON). Built-in: alarabytv, i24news, aljazeera, timesofisrael, jpost, memo; or rss:https://…
WEB_FEEDS=alarabytv,i24news
WEB_POLL_MS=300000
